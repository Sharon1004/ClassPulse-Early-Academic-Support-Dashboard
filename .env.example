# Copy this file to server/.env and fill in your own values. NEVER commit server/.env.

# Optional. Leave empty to use the built-in local file store (server/data/db.json).
# For MongoDB Atlas (free M0), paste your connection string from Atlas > Connect > Drivers.
MONGODB_URI=
MONGODB_DB=classpulse

# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Password given to the three demo accounts (admin@, teacher@, student@classpulse.demo).
# Required in production. In development a built-in demo password (ClassPulse@2026) is used if empty.
DEMO_PASSWORD=

PORT=5000
# Only needed if the frontend is hosted on a different origin than the API.
CLIENT_ORIGIN=
